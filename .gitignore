# Large simulation output -- do NOT commit.
# Production runs at 50^3 cells and above generate hundreds of MB to GB of
# configuration data. Committing it permanently inflates the repository and the
# history cannot be cleaned afterwards. Use Zenodo or Git LFS instead.
*.npy
*.npz
*.h5
*.hdf5
*.pkl
outputs/raw/
data/raw/
data/configurations/

# OS
.DS_Store
Thumbs.db
